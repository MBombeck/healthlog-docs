---
// Starlight's footer plus the control that opens the visit-counting panel,
// where a visitor can object (public/analytics.js).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="hl-consent-settings">
	<button type="button" onclick="window.hlAnalyticsSettings && window.hlAnalyticsSettings()">
		Analytics settings
	</button>
</p>
