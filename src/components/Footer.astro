---
// Starlight's footer plus the control that opens the visit-counting panel,
// where a visitor can object (public/analytics.js).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="hl-consent-settings">
	<button type="button" data-hl-analytics-settings>
		Analytics settings
	</button>
</p>

<script>
	// Bundled with a content hash, unlike public/analytics.js, which is served
	// as immutable under a fixed name. No inline onclick, so the CSP needs no
	// 'unsafe-inline'.
	document.addEventListener('click', (e) => {
		if (e.target instanceof Element && e.target.closest('[data-hl-analytics-settings]')) {
			(window as unknown as { hlAnalyticsSettings?: () => void }).hlAnalyticsSettings?.();
		}
	});
</script>
